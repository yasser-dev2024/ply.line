; Godot project configuration for Lion Battle 3D.
; Edit through the Godot editor where possible.

config_version=5

[application]

config/name="القتال مع الأسود 3D"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.075, 0.055, 1)
boot_splash/image="res://assets/icons/logo.png"
config/icon="res://assets/icons/icon.png"

[autoload]

GameState="*res://scripts/storage/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

3d/default_gravity=24.0
common/enable_pause_aware_picking=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.18, 0.32, 0.28, 1)
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/directional_shadow/size=2048

[audio]

driver/enable_input=false

[internationalization]

locale/fallback="ar"
